---
import { Image } from "astro:assets"
import { getEntry } from "astro:content"
import PageShell from "../components/PageShell.astro"
import PortfolioSection from "../components/PortfolioSection.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getVisibleSpanishProjects } from "../lib/portfolio"
import "../styles/home.css"

import montsePortrait from "../assets/images/homepage/montse-pereda-portrait.png"

const home = await getEntry("homepage", "homepage")

if (!home) {
  throw new Error("Falta el contenido validado de la portada.")
}

const publishedProjects = await getVisibleSpanishProjects(false)
const heroAccentPhrase = "estrategia digital"
const heroAccentStart = home.data.heroTitle.toLocaleLowerCase("es").lastIndexOf(heroAccentPhrase)
const heroTitleLead =
  heroAccentStart >= 0
    ? home.data.heroTitle.slice(0, heroAccentStart).trimEnd()
    : home.data.heroTitle
const heroTitleAccent =
  heroAccentStart >= 0 ? home.data.heroTitle.slice(heroAccentStart) : undefined
const connectionLinkStart = home.data.connectionLabel.indexOf(home.data.connectionLink.label)
const connectionLabelBefore = home.data.connectionLabel.slice(0, connectionLinkStart)
const connectionLabelAfter = home.data.connectionLabel.slice(
  connectionLinkStart + home.data.connectionLink.label.length,
)
---

<BaseLayout canonicalPath="/">
  <PageShell pageClass="home-page" mainClass="home-main">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="text-container">
          <p class="kicker home-kicker">{home.data.heroEyebrow}</p>
          <h1 id="hero-title">
            <span>{heroTitleLead}</span>
            {heroTitleAccent && <em>{heroTitleAccent}</em>}
          </h1>
          <p class="intro-lead home-intro__description">
            {connectionLabelBefore}<a href={home.data.connectionLink.href}
              >{home.data.connectionLink.label}</a
            >{connectionLabelAfter}
          </p>
          <a class="hero-cta" href="/montse-pereda-cv.pdf" download>
            Descarga mi CV <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="img-container">
          <Image
            src={montsePortrait}
            width={760}
            height={760}
            format="webp"
            quality={85}
            class="hero-image"
            alt="Retrato de Montse Pereda Grillo con americana gris y jersey blanco sobre fondo claro"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="home-portfolio" id="indice" aria-label="Portafolio">
      <PortfolioSection
        projects={publishedProjects}
        headingLevel="h2"
        titleId="home-portfolio-title"
      />
    </section>
  </PageShell>
</BaseLayout>
